# ==========================================
# Go Compiled Binaries & Test Artifacts
# ==========================================
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Avoid tracking compiled main binaries if named after your repo
bin/
dist/

# ==========================================
# Dependency Directories 
# ==========================================
# Keep vendor/ ignored unless you explicitly want to commit dependencies
vendor/

# ==========================================
# Environment Configuration & Logs (Secure)
# ==========================================
.env
.env.*
*.log

# Common local editor caches
.DS_Store
